{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ertekinozturgut/strapi-agent-squad/tasks.schema.json",
  "title": "Strapi Agent Squad Task Queue",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "title", "description", "status", "priority", "dependencies", "assignedSquad", "dorMet", "dodMet", "artifacts"],
    "properties": {
      "id": { "type": "string", "pattern": "^TASK-[0-9]+$" },
      "title": { "type": "string", "minLength": 1 },
      "description": { "type": "string", "minLength": 1 },
      "status": { "enum": ["pending", "in_progress", "in_review", "changes_requested", "blocked", "completed"] },
      "priority": { "enum": ["low", "medium", "high", "critical"] },
      "dependencies": { "type": "array", "items": { "type": "string", "pattern": "^TASK-[0-9]+$" }, "uniqueItems": true },
      "assignedSquad": {
        "type": "object",
        "additionalProperties": false,
        "required": ["orchestrator", "analyst", "architect", "developers", "reviewers"],
        "properties": {
          "orchestrator": { "const": "project-manager" },
          "analyst": { "const": "cms-business-analyst" },
          "architect": { "const": "strapi-solution-architect" },
          "developers": { "type": "array", "items": { "enum": ["strapi-backend-engineer", "admin-plugin-engineer", "platform-integration-engineer"] }, "minItems": 1, "uniqueItems": true },
          "reviewers": { "type": "array", "items": { "enum": ["qa-tester", "security-reviewer"] }, "minItems": 2, "uniqueItems": true }
        }
      },
      "dorMet": { "type": "boolean" },
      "dodMet": { "type": "boolean" },
      "rejectionCount": { "type": "integer", "minimum": 0, "default": 0 },
      "reviewNotes": { "type": "array", "items": { "type": "string" }, "default": [] },
      "artifacts": {
        "type": "object",
        "additionalProperties": false,
        "required": ["userStory", "acceptanceCriteria", "contentModelChanges", "apiContracts", "permissionMatrix", "migrationPlan", "dataClassification", "pluginImpacts", "testsWritten", "securityEvidence", "rolloutPlan", "rollbackPlan", "toolAuditResults"],
        "properties": {
          "userStory": { "type": "string" },
          "acceptanceCriteria": { "type": "array", "items": { "type": "string" } },
          "contentModelChanges": { "type": "array", "items": { "type": "string" } },
          "apiContracts": { "type": "array", "items": { "type": "string" } },
          "permissionMatrix": { "type": "array", "items": { "type": "string" } },
          "migrationPlan": { "type": "string" },
          "dataClassification": { "type": "array", "items": { "type": "string" } },
          "pluginImpacts": { "type": "array", "items": { "type": "string" } },
          "testsWritten": { "type": "array", "items": { "type": "string" } },
          "securityEvidence": { "type": "array", "items": { "type": "string" } },
          "rolloutPlan": { "type": "string" },
          "rollbackPlan": { "type": "string" },
          "toolAuditResults": {
            "type": "object",
            "additionalProperties": { "enum": ["pass", "fail", "skip"] },
            "required": ["typecheck", "lint", "testgen", "unit", "integration", "security"]
          },
          "suppressions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ruleId", "reason", "owner", "expiresAt"],
              "properties": {
                "ruleId": { "type": "string" },
                "reason": { "type": "string" },
                "owner": { "type": "string" },
                "expiresAt": { "type": "string", "format": "date" }
              }
            }
          }
        }
      }
    }
  }
}
